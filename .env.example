# Base URL of the rag-backend FastAPI service (see ~/rag-backend/README.md:
# `uvicorn app.main:app --reload --port 8001`).
# Prefixed NEXT_PUBLIC_ so it's readable from both server and client components.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Keycloak that users sign in at. The default is the test instance from
# rag-backend's docker compose (users alice/alice and bob/bob); use the
# address browsers reach it at - the Tailscale IP when the app is opened
# over Tailscale.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=rag
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=rag-frontend
